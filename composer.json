{
    "name": "creacoon/laravel-dashboard-dutch-trains",
    "description": "Fetch upcoming departures for the live departure board tile",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^4.0",
        "nesbot/carbon": "^2.72.2|^3.0",
        "spatie/laravel-dashboard": "^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.18|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Creacoon\\LiveDepartureBoardTile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Creacoon\\LiveDepartureBoardTile\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Creacoon\\LiveDepartureBoardTile\\LiveDepartureBoardTileServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "format": "pint --test"
    }
}