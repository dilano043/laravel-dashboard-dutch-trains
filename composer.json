{
    "name": "creacoon/laravel-dashboard-live-departure-board-tile",
    "version": "1.0.0",
    "description": "A Dutch trains tile for Spatie Laravel Dashboard",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^4.0",
        "spatie/laravel-dashboard": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Creacoon\\LiveDepartureBoardTile\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Creacoon\\LiveDepartureBoardTile\\LiveDepartureBoardTileServiceProvider"
            ]
